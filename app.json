{
  "expo": {
    "name": "Qiraat Al-Qur'an",
    "slug": "qiraat-al-quran",
    "version": "1.0.0",
    "scheme": "qiraat-al-qur-an",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.qiraat_al_qur_an"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#fbf8ef"
      },
      "package": "com.qiraat.alquran",
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fbf8ef"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aplikasi memakai lokasi untuk menentukan arah kiblat."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "09626e97-32f3-4cfa-b56f-c74e2032855e"
      }
    }
  }
}