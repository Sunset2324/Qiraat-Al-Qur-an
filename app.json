{
  "expo": {
    "name": "Qiraat-Al-Qur-an",
    "slug": "qiraat-al-qur-an",
    "version": "1.0.0",
    "scheme": "qiraat-al-qur-an",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro"
    },
    "fonts": {
      "asset": "./assets/fonts/KFGQPC-Uthman-Taha-Naskh-Regular.ttf"
    },
    "jsEngine": "hermes",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone" 
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e92b93e1-7f22-419c-a971-d52ddd7723da"
      }
    },
    "android": {
      "package": "com.sambelcode.qiraatalquran",
      "permissions":[
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    }
  }
}